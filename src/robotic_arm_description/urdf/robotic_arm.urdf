<?xml version="1.0"?>

<robot name="robotic_arm">

  <!-- ========================================================= -->
  <!-- MATERIALS                                                  -->
  <!-- ========================================================= -->

  <material name="orange">
    <color rgba="0.95 0.35 0.05 1.0"/>
  </material>

  <material name="orange_dark">
    <color rgba="0.75 0.20 0.03 1.0"/>
  </material>

  <material name="yellow">
    <color rgba="0.95 0.75 0.05 1.0"/>
  </material>

  <material name="blue_gray">
    <color rgba="0.35 0.42 0.48 1.0"/>
  </material>

  <material name="dark_gray">
    <color rgba="0.12 0.14 0.16 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.03 0.03 0.03 1.0"/>
  </material>


  <!-- ========================================================= -->
  <!-- BASE                                                       -->
  <!-- ========================================================= -->

  <link name="base_link">

    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.18" length="0.10"/>
      </geometry>
      <material name="blue_gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.18" length="0.10"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia
        ixx="0.05"
        ixy="0.0"
        ixz="0.0"
        iyy="0.05"
        iyz="0.0"
        izz="0.08"/>
    </inertial>

  </link>


  <!-- ========================================================= -->
  <!-- JOINT 1 - BASE YAW                                         -->
  <!-- ========================================================= -->

  <joint name="joint_1" type="revolute">

    <parent link="base_link"/>
    <child link="link_1"/>

    <origin xyz="0 0 0.10" rpy="0 0 0"/>

    <axis xyz="0 0 1"/>

    <limit
      lower="-3.14159"
      upper="3.14159"
      effort="150"
      velocity="2.0"/>

    <dynamics
      damping="0.5"
      friction="0.2"/>

  </joint>


  <!-- ========================================================= -->
  <!-- LINK 1 - LOWER ROTARY HOUSING                              -->
  <!-- ========================================================= -->

  <link name="link_1">

    <visual>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.13" length="0.24"/>
      </geometry>
      <material name="orange"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.13" length="0.24"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <mass value="3.5"/>
      <inertia
        ixx="0.035"
        ixy="0.0"
        ixz="0.0"
        iyy="0.035"
        iyz="0.0"
        izz="0.025"/>
    </inertial>

  </link>


  <!-- ========================================================= -->
  <!-- JOINT 2 - SHOULDER                                         -->
  <!-- ========================================================= -->

  <joint name="joint_2" type="revolute">

    <parent link="link_1"/>
    <child link="link_2"/>

    <origin xyz="0 0 0.24" rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

    <limit
      lower="-2.6"
      upper="2.6"
      effort="150"
      velocity="2.0"/>

    <dynamics
      damping="0.5"
      friction="0.2"/>

  </joint>


  <!-- ========================================================= -->
  <!-- LINK 2 - LONG LOWER ARM                                    -->
  <!-- ========================================================= -->

  <link name="link_2">

    <visual>
      <origin xyz="0 0 0.40" rpy="0 0 0"/>
      <geometry>
        <box size="0.14 0.14 0.80"/>
      </geometry>
      <material name="orange"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.40" rpy="0 0 0"/>
      <geometry>
        <box size="0.14 0.14 0.80"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.40" rpy="0 0 0"/>
      <mass value="4.0"/>
      <inertia
        ixx="0.25"
        ixy="0.0"
        ixz="0.0"
        iyy="0.25"
        iyz="0.0"
        izz="0.015"/>
    </inertial>

  </link>


  <!-- ========================================================= -->
  <!-- JOINT 3 - ELBOW                                            -->
  <!-- ========================================================= -->

  <joint name="joint_3" type="revolute">

    <parent link="link_2"/>
    <child link="link_3"/>

    <origin xyz="0 0 0.80" rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

    <limit
      lower="-2.8"
      upper="2.8"
      effort="120"
      velocity="2.5"/>

    <dynamics
      damping="0.4"
      friction="0.15"/>

  </joint>


  <!-- ========================================================= -->
  <!-- LINK 3 - ELBOW / MID ARM HOUSING                           -->
  <!-- ========================================================= -->

  <link name="link_3">

    <visual>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.16"/>
      </geometry>
      <material name="orange"/>
    </visual>

    <visual>
      <origin xyz="0 0 0.16" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.055" length="0.025"/>
      </geometry>
      <material name="yellow"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.16"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <mass value="2.5"/>
      <inertia
        ixx="0.025"
        ixy="0.0"
        ixz="0.0"
        iyy="0.025"
        iyz="0.0"
        izz="0.018"/>
    </inertial>

  </link>


  <!-- ========================================================= -->
  <!-- JOINT 4 - FOREARM / WRIST ROTATION                         -->
  <!-- ========================================================= -->

  <joint name="joint_4" type="revolute">

    <parent link="link_3"/>
    <child link="link_4"/>

    <origin xyz="0 0 0.16" rpy="0 0 0"/>

    <axis xyz="1 0 0"/>

    <limit
      lower="-3.14159"
      upper="3.14159"
      effort="80"
      velocity="3.0"/>

    <dynamics
      damping="0.3"
      friction="0.1"/>

  </joint>


  <!-- ========================================================= -->
  <!-- LINK 4 - LONG UPPER ARM                                    -->
  <!-- ========================================================= -->

  <link name="link_4">

    <visual>
      <origin xyz="0 0 0.35" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.12 0.70"/>
      </geometry>
      <material name="orange"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.35" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.12 0.70"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.35" rpy="0 0 0"/>
      <mass value="3.0"/>
      <inertia
        ixx="0.125"
        ixy="0.0"
        ixz="0.0"
        iyy="0.125"
        iyz="0.0"
        izz="0.012"/>
    </inertial>

  </link>


  <!-- ========================================================= -->
  <!-- JOINT 5 - WRIST PITCH                                      -->
  <!-- ========================================================= -->

  <joint name="joint_5" type="revolute">

    <parent link="link_4"/>
    <child link="link_5"/>

    <origin xyz="0 0 0.70" rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

    <limit
      lower="-2.5"
      upper="2.5"
      effort="50"
      velocity="3.0"/>

    <dynamics
      damping="0.2"
      friction="0.08"/>

  </joint>


  <!-- ========================================================= -->
  <!-- LINK 5 - WRIST HOUSING                                     -->
  <!-- ========================================================= -->

  <link name="link_5">

    <visual>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.09" length="0.20"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.09" length="0.20"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia
        ixx="0.008"
        ixy="0.0"
        ixz="0.0"
        iyy="0.008"
        iyz="0.0"
        izz="0.006"/>
    </inertial>

  </link>


  <!-- ========================================================= -->
  <!-- JOINT 6 - TOOL ROLL                                        -->
  <!-- ========================================================= -->

  <joint name="joint_6" type="revolute">

    <parent link="link_5"/>
    <child link="tool0"/>

    <origin xyz="0 0 0.20" rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

    <limit
      lower="-3.14159"
      upper="3.14159"
      effort="30"
      velocity="4.0"/>

    <dynamics
      damping="0.15"
      friction="0.05"/>

  </joint>


  <!-- ========================================================= -->
  <!-- TOOL / END EFFECTOR                                        -->
  <!-- ========================================================= -->

  <link name="tool0">

    <!-- Main flange -->
    <visual>
      <origin xyz="0 0 0.035" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.075" length="0.07"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>

    <!-- Tool housing -->
    <visual>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.10"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.035" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.075" length="0.07"/>
      </geometry>
    </collision>

    <collision>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.10"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <mass value="0.6"/>
      <inertia
        ixx="0.002"
        ixy="0.0"
        ixz="0.0"
        iyy="0.002"
        iyz="0.0"
        izz="0.001"/>
    </inertial>

  </link>

</robot>
