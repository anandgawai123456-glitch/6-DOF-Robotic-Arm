<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="robotic_arm">

  <!-- =========================
       MATERIALS
       ========================= -->

  <material name="gray">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>


  <!-- =========================
       BASE
       ========================= -->

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robotic_arm_description/meshes/base.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robotic_arm_description/meshes/base.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0"
               iyy="0.1" iyz="0"
               izz="0.1"/>
    </inertial>
  </link>


  <!-- =========================
       LINK 1
       ========================= -->

  <link name="link1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robotic_arm_description/meshes/link1.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robotic_arm_description/meshes/link1.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="3.0"/>
      <inertia ixx="0.05" ixy="0" ixz="0"
               iyy="0.05" iyz="0"
               izz="0.05"/>
    </inertial>
  </link>


  <!-- J1 -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>

    <!-- TEMPORARY -->
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>

    <limit
      lower="-3.14159"
      upper="3.14159"
      effort="100"
      velocity="2.0"/>
  </joint>


  <!-- =========================
       LINK 2
       ========================= -->

  <link name="link2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robotic_arm_description/meshes/link2.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robotic_arm_description/meshes/link2.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="3.0"/>
      <inertia ixx="0.05" ixy="0" ixz="0"
               iyy="0.05" iyz="0"
               izz="0.05"/>
    </inertial>
  </link>


  <!-- J2 -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>

    <!-- TEMPORARY -->
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>

    <limit
      lower="-3.14159"
      upper="3.14159"
      effort="100"
      velocity="2.0"/>
  </joint>


  <!-- =========================
       LINK 3
       ========================= -->

  <link name="link3">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robotic_arm_description/meshes/link3.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robotic_arm_description/meshes/link3.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="2.5"/>
      <inertia ixx="0.04" ixy="0" ixz="0"
               iyy="0.04" iyz="0"
               izz="0.04"/>
    </inertial>
  </link>


  <!-- LINK 2 TO LINK 3: FIXED -->
  <joint name="link2_to_link3" type="fixed">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- J3: ROTATES LINK 4 AND DOWNSTREAM -->
  <joint name="joint3" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>

    <limit
      lower="-3.14159"
      upper="3.14159"
      effort="100"
      velocity="2.0"/>
  </joint>


  <!-- =========================
       LINK 4
       ========================= -->

  <link name="link4">
    <visual>
      <geometry>
        <mesh filename="package://robotic_arm_description/meshes/link4.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <collision>
      <geometry>
        <mesh filename="package://robotic_arm_description/meshes/link4.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.03" ixy="0" ixz="0"
               iyy="0.03" iyz="0"
               izz="0.03"/>
    </inertial>
  </link>


  <!-- J4 -->
  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>

    <!-- TEMPORARY -->
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>

    <limit
      lower="-3.14159"
      upper="3.14159"
      effort="50"
      velocity="3.0"/>
  </joint>


  <!-- =========================
       LINK 5
       ========================= -->

  <link name="link5">
    <visual>
      <geometry>
        <mesh filename="package://robotic_arm_description/meshes/link5.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <collision>
      <geometry>
        <mesh filename="package://robotic_arm_description/meshes/link5.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="1.5"/>
      <inertia ixx="0.02" ixy="0" ixz="0"
               iyy="0.02" iyz="0"
               izz="0.02"/>
    </inertial>
  </link>


  <!-- J5 -->
  <joint name="joint5" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>

    <!-- TEMPORARY -->
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>

    <limit
      lower="-3.14159"
      upper="3.14159"
      effort="50"
      velocity="3.0"/>
  </joint>


  <!-- =========================
       LINK 6
       ========================= -->

  <link name="link6">
    <visual>
      <geometry>
        <mesh filename="package://robotic_arm_description/meshes/link6.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <collision>
      <geometry>
        <mesh filename="package://robotic_arm_description/meshes/link6.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0"
               iyy="0.01" iyz="0"
               izz="0.01"/>
    </inertial>
  </link>


  <!-- J6 -->
  <joint name="joint6" type="revolute">
    <parent link="link5"/>
    <child link="link6"/>

    <!-- TEMPORARY -->
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>

    <limit
      lower="-3.14159"
      upper="3.14159"
      effort="30"
      velocity="3.0"/>
  </joint>


  <!-- =========================
       TOOL
       ========================= -->

  <link name="tool_link">
    <visual>
      <geometry>
        <mesh filename="package://robotic_arm_description/meshes/tool.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <collision>
      <geometry>
        <mesh filename="package://robotic_arm_description/meshes/tool.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.005" ixy="0" ixz="0"
               iyy="0.005" iyz="0"
               izz="0.005"/>
    </inertial>
  </link>


  <!-- Fixed tool connection -->
  <joint name="tool_joint" type="fixed">
    <parent link="link6"/>
    <child link="tool_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

</robot>
